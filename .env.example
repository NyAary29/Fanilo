# ------------------------------------------------------------------
# FANILO — variables d'environnement (copier en .env, ne jamais committer .env)
# ------------------------------------------------------------------

# development | test | production
FANILO_ENVIRONMENT=development

# Clé secrète (JWT, signatures). OBLIGATOIRE en production, >= 32 caractères.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
FANILO_SECRET_KEY=change-me-dev-only

# DEBUG | INFO | WARNING | ERROR
FANILO_LOG_LEVEL=INFO
# json (recommandé) | text (lisible en local)
FANILO_LOG_FORMAT=json

# Origines autorisées pour le dashboard (séparées par des virgules)
FANILO_CORS_ORIGINS=http://localhost:5173

# Documentation OpenAPI (/docs). Désactivée par défaut en production.
FANILO_ENABLE_DOCS=true

# Autorise le service de contenus de DÉMONSTRATION non validés cliniquement.
# Interdit en production (refusé au démarrage).
FANILO_ALLOW_DEMO_CONTENT=false

# PostgreSQL (utilisé à partir du lot P0.2)
POSTGRES_USER=fanilo
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=fanilo
# Port local publié par docker compose (à changer si 5432 est déjà pris)
# FANILO_DB_PORT=5432
FANILO_DATABASE_URL=postgresql+psycopg://fanilo:change-me-dev-only@localhost:5432/fanilo
# Affiche les requêtes SQL (développement uniquement : peut exposer des données)
FANILO_DATABASE_ECHO=false

# Authentification (lot P0.3)
# Durée de vie du jeton d'accès JWT, en minutes (1 à 60)
FANILO_ACCESS_TOKEN_TTL_MINUTES=15
# Durée de vie du jeton de rafraîchissement rotatif, en jours (1 à 90)
FANILO_REFRESH_TOKEN_TTL_DAYS=30
# Limitation des tentatives de connexion (en mémoire, PAR INSTANCE :
# insuffisant en multi-instance, prévoir Redis ou le reverse proxy)
FANILO_LOGIN_MAX_ATTEMPTS=5
FANILO_LOGIN_WINDOW_SECONDS=300

# Chiffrement des colonnes nominatives (lot P0.5). OBLIGATOIRE en production.
# Clé Fernet ; plusieurs clés séparées par des virgules pour une rotation (la
# première chiffre, toutes déchiffrent). Absente hors production : clé éphémère
# (données nominatives illisibles après redémarrage).
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FANILO_DATA_ENCRYPTION_KEY=

# Calendrier CPN configuré (lot P0.7). Le fichier de démo (status: demo) n'est
# utilisable que si FANILO_ALLOW_DEMO_CONTENT=true ; à remplacer par le
# protocole validé du Ministère de la Santé (status: validated).
# FANILO_ANC_SCHEDULE_PATH=config/anc_schedule.demo.yaml

# Moteur de règles (services/rules), chargé une fois au démarrage avec
# allow_demo=FANILO_ALLOW_DEMO_CONTENT. Par défaut : jeu et référentiel de
# DÉMONSTRATION du dépôt (refusés si FANILO_ALLOW_DEMO_CONTENT=false). Sans jeu
# chargeable, l'API démarre mais /interactions/ask répond toujours en fallback.
# FANILO_RULES_RULESET_PATH=../rules/rulesets/demo/reny_danger_signs.demo.yaml
# FANILO_RULES_SIGN_CATALOG_PATH=../rules/rulesets/demo/sign_codes.demo.yaml
# Code de message de repli utilisé uniquement si aucun jeu de règles n'est chargé.
# FANILO_FALLBACK_MESSAGE_CODE=

# Service IA interne (services/ai) : délai maximal court, échec => fallback.
FANILO_AI_SERVICE_URL=http://localhost:8001
# Avec Whisper sur processeur (sans GPU), prévoir 20 à 30 s.
FANILO_AI_TIMEOUT_SECONDS=5
# Taille maximale de l'audio relayé (en mémoire, jamais stocké) : même valeur
# que FANILO_AI_MAX_AUDIO_BYTES côté service IA.
FANILO_AI_MAX_AUDIO_BYTES=5242880

# Délai de réponse des alertes dont la règle n'a qu'un délai PLACEHOLDER (jeux
# de démonstration). Valeur de DÉMONSTRATION, non clinique (minutes).
FANILO_ALERT_DEMO_RESPONSE_MINUTES=60

# Information présentée lors du consentement (fichier versionné ; le fichier de
# démo n'est servi que si FANILO_ALLOW_DEMO_CONTENT=true).
# FANILO_CONSENT_INFORMATION_PATH=config/consent_information.demo.yaml

# --- OpenAI (facultatif) -------------------------------------------------------
# Avec une clé, scripts/dev.sh utilise OpenAI pour la voix (gpt-4o-transcribe) et la
# compréhension (gpt-4o-mini, liste fermée), avec secours local. ATTENTION : l'audio et
# le texte des questions sont alors envoyés à OpenAI (hors de Madagascar).
# FANILO_AI_OPENAI_API_KEY=sk-...
# FANILO_AI_OPENAI_ASR_MODEL=gpt-4o-transcribe
# FANILO_AI_OPENAI_NLU_MODEL=gpt-4o-mini
